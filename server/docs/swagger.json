    "definitions": {
        "github_com_yogesh4952_ebookstore_internal_address_models.UserAddress": {
            "type": "object",
            "required": [
                "city",
                "delivery_address",
                "user_id"
            ],
            "properties": {
                "city": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "deletedAt": {
                    "$ref": "#/definitions/gorm.DeletedAt"
                },
                "delivery_address": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "updatedAt": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/github_com_yogesh4952_ebookstore_internal_user_models.User"
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
        "github_com_yogesh4952_ebookstore_internal_auth_models.RegisterPayload": {
            "type": "object",
            "required": [
                "age",
                "email",
                "first_name",
                "last_name",
                "role"
            ],
            "properties": {
                "age": {
                    "type": "integer"
                },
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "role": {
                    "$ref": "#/definitions/github_com_yogesh4952_ebookstore_internal_user_models.Role"
                }
            }
        },
        "github_com_yogesh4952_ebookstore_internal_book_models.PublishBookPayload": {
            "type": "object",
            "required": [
                "author_name",
                "category",
                "genre",
                "pages",
                "price",
                "publication",
                "title",
                "units"
            ],
            "properties": {
                "author_name": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                },
                "cover_page_url": {
                    "type": "string"
                },
                "genre": {
                    "type": "string"
                },
                "pages": {
                    "type": "integer",
                    "minimum": 10
                },
                "price": {
                    "type": "integer",
                    "minimum": 1000
                },
                "publication": {
                    "type": "string"
                },
                "seller_id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string",
                    "maxLength": 60,
                    "minLength": 2
                },
                "units": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "github_com_yogesh4952_ebookstore_internal_book_models.UpdateBookPayload": {
            "type": "object",
            "required": [
                "book_id",
                "seller_id"
            ],
            "properties": {
                "author_name": {
                    "type": "string"
                },
                "book_id": {
                    "type": "integer"
                },
                "category": {
                    "type": "string"
                },
                "cover_page_url": {
                    "type": "string"
                },
                "genre": {
                    "type": "string"
                },
                "pages": {
                    "type": "integer",
                    "minimum": 10
                },
                "price": {
                    "type": "integer",
                    "minimum": 1000
                },
                "publication": {
                    "type": "string"
                },
                "seller_id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string",
                    "maxLength": 60,
                    "minLength": 2
                },
                "units": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "github_com_yogesh4952_ebookstore_internal_order_models.OrderItemRequest": {
            "type": "object",
            "required": [
                "book_id",
                "quantity",
                "seller_id"
            ],
            "properties": {
                "book_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 1
                },
                "seller_id": {
                    "type": "integer"
                }
            }
        },
        "github_com_yogesh4952_ebookstore_internal_order_models.PaymentMethod": {
            "type": "string",
            "enum": [
                "COD",
                "ESEWA"
            ],
            "x-enum-varnames": [
                "PayementCOD",
                "PayementEsewa"
            ]
        },
        "github_com_yogesh4952_ebookstore_internal_order_models.PlaceOrderPayload": {
            "type": "object",
            "required": [
                "items",
                "payment_method",
                "user_address_id"
            ],
            "properties": {
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/github_com_yogesh4952_ebookstore_internal_order_models.OrderItemRequest"
                    }
                },
                "payment_method": {
                    "$ref": "#/definitions/github_com_yogesh4952_ebookstore_internal_order_models.PaymentMethod"
                },
                "user_address_id": {
                    "type": "integer"
                }
            }
        },
        "github_com_yogesh4952_ebookstore_internal_user_models.Role": {
            "type": "string",
            "enum": [
                "admin",
                "customer",
                "seller"
            ],
            "x-enum-varnames": [
                "RoleAdmin",
                "RoleCustomer",
                "Roleseller"
            ]
        },
        "github_com_yogesh4952_ebookstore_internal_user_models.User": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "deletedAt": {
                    "$ref": "#/definitions/gorm.DeletedAt"
                },
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "last_name": {
                    "type": "string"
                },
                "phone_number": {
                    "type": "string"
                },
                "role": {
                    "$ref": "#/definitions/github_com_yogesh4952_ebookstore_internal_user_models.Role"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "gorm.DeletedAt": {
            "type": "object",
            "properties": {
                "time": {
                    "type": "string"
                },
                "valid": {
                    "description": "Valid is true if Time is not NULL",
                    "type": "boolean"
                }
            }
        },
        "internal_auth_handler.LoginPayload": {
            "type": "object",
            "required": [
                "email",
                "otp"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "otp": {
                    "type": "string"
                }
            }
        },
        "internal_auth_handler.SendOTPRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
